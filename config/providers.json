{
  "version": 4,
  "dry_run_by_default": true,
  "text": {
    "provider": "openai",
    "model": "gpt-5.6-luna",
    "reasoning_effort": "medium",
    "research_web_search": true,
    "max_output_tokens": 6000
  },
  "assets": {
    "provider": "openai",
    "support_model": "gpt-image-1-mini",
    "support_quality": "medium",
    "hero_model": "gpt-image-2",
    "hero_quality": "medium",
    "hero_limits": {
      "short": 1,
      "long": 2
    },
    "short_size": "1024x1536",
    "long_size": "1536x1024"
  },
  "voice": {
    "provider": "owner_recording",
    "source": "owner_recording_only",
    "ai_voice_allowed": false,
    "cloned_voice_allowed": false,
    "required_spec_field": "owner_voice_media_ref"
  },
  "captions": {
    "provider": "openai-transcription",
    "model": "whisper-1",
    "word_timestamps": true,
    "source": "owner_recording"
  },
  "thumbnail": {
    "provider": "openai",
    "model": "gpt-image-2",
    "quality": "medium",
    "size": "1536x1024",
    "text_policy": "no-words-by-default",
    "avatar_style": "consistent-unrealistic-paper-cut-esiah-avatar"
  }
}
