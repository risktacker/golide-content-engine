      "visual": "icon_pair",
      "subjects": [
        "cloud",
        "laptop"
      ],
      "label": "WHERE IT RUNS",
      "follow": false
    },
    {
      "section": "claim",
      "chapter": 0,
      "text": "Follow GOLIDE now, because the feed won't show us to you twice,",
      "emphasis": "Follow GOLIDE",
      "visual": "icon_hero",
      "subjects": [
        "phone"
      ],
      "label": "",
      "follow": true
    },
    {
