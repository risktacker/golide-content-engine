      "visual": "icon_hero",
      "subjects": [
        "laptop"
      ],
      "label": "ON DEVICE",
      "follow": false
    },
    {
      "section": "proof",
      "chapter": 0,
      "text": "using a small AI chip called a neural processing unit,",
      "emphasis": "neural processing unit",
      "visual": "icon_hero",
      "subjects": [
        "computer chip"
      ],
      "label": "NPU",
      "follow": false
    },
    {
      "section": "proof",
      "chapter": 0,
