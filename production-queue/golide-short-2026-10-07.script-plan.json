      "visual": "icon_pair",
      "subjects": [
        "brain",
        "cloud"
      ],
      "label": "CLOUD",
      "follow": false
    },
    {
      "section": "cost",
      "chapter": 0,
      "text": "Ignore that difference, and here's what happens.",
      "emphasis": "ignore",
      "visual": "icon_hero",
      "subjects": [
        "warning sign"
      ],
      "label": "THE COST",
      "follow": false
    },
    {
      "section": "cost",
      "chapter": 0,
      "text": "You chase the highest benchmark, then wait for a connection,",
