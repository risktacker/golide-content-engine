      "visual": "icon_pair",
      "subjects": [
        "computer chip",
        "cloud"
      ],
      "label": "CLOUD",
      "follow": false
    },
    {
      "section": "pattern",
      "chapter": 0,
      "text": "So the operating system acts like a traffic controller,",
      "emphasis": "traffic controller",
