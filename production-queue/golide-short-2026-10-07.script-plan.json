      "visual": "icon_orbit",
      "subjects": [
        "traffic light",
        "computer chip",
        "cloud"
      ],
      "label": "ROUTING",
      "follow": false
    },
    {
      "section": "pattern",
      "chapter": 0,
      "text": "Small models stay nearby for speed, privacy and offline use,",
