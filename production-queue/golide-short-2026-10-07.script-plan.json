      ],
      "label": "IT DEPENDS",
      "follow": false
    },
    {
      "section": "cta",
      "chapter": 0,
      "text": "Before you pick a tool, ask what matters most,",
      "emphasis": "matters most",
      "visual": "checklist",
      "subjects": [
        "checklist"
      ],
      "label": "ASK FIRST",
      "follow": false
    },
    {
      "section": "cta",
      "chapter": 0,
